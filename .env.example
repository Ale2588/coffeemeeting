# Copia in .env.local e compila. Non fare mai commit di .env.
# Le variabili VITE_* finiscono nel bundle del browser: solo chiavi pubbliche.

# Supabase (fase 2) — pubbliche
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo lato server (funzioni Vercel in api/, fase 5): mai con prefisso VITE_, mai nel browser.
# SUPABASE_URL=               # facoltativa: se manca si usa VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=  # Supabase → Project Settings → API Keys → service_role (segreta)
# STRIPE_SECRET_KEY=          # modalità di prova: sk_test_...
# STRIPE_WEBHOOK_SECRET=      # whsec_... dall'endpoint webhook su Stripe
# SITE_URL=                   # facoltativa: indirizzo del sito per i ritorni da Stripe

# Fase 7
# RESEND_API_KEY=
