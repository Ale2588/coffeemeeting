# Copia in .env.local e compila. Non fare mai commit di .env.
# Le variabili VITE_* finiscono nel bundle del browser: solo chiavi pubbliche.

# Supabase (fase 2)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo lato server (Edge Functions, fasi 5 e 7): mai con prefisso VITE_
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=          # modalità di prova: sk_test_...
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
